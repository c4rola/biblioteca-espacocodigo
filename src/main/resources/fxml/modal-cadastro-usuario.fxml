<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="500.0" spacing="25.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.controller.ModalCadastroUsuario">
   <children>
      <TextField fx:id="txtNome" maxWidth="-Infinity" prefHeight="0.0" prefWidth="350.0" promptText="Nome" />
      <TextField fx:id="txtCpf" maxWidth="-Infinity" prefHeight="0.0" prefWidth="350.0" promptText="CPF" />
      <TextField fx:id="txtEmail" maxWidth="-Infinity" prefHeight="0.0" prefWidth="350.0" promptText="E-mail" />
      <TextField fx:id="txtTelefone" maxWidth="-Infinity" prefHeight="0.0" prefWidth="350.0" promptText="Telefone" />
      <Button fx:id="btnSalvar" alignment="CENTER" mnemonicParsing="false" onAction="#handleSalvarUsuario" text="Cadastrar usuário" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
