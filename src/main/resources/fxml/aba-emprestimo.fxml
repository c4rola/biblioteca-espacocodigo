<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="688.0" prefWidth="882.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.controller.EmprestimoController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox maxWidth="-Infinity" prefWidth="500.0" spacing="20.0">
         <children>
            <TextField fx:id="txtCpfUsuario" prefHeight="26.0" prefWidth="150.0" promptText=" CPF ( Apenas números )" />
            <Label fx:id="lblNomeUsuario" prefHeight="26.0" prefWidth="354.0" style="-fx-border-color: black; -fx-border-width: 1;" />
         </children>
      </HBox>
      <HBox maxWidth="-Infinity" prefHeight="26.0" prefWidth="500.0" spacing="20.0">
         <children>
            <TextField fx:id="txtCodigoLivro" prefHeight="26.0" prefWidth="150.0" promptText="Código do livro" />
            <Label fx:id="lblTituloLivro" prefHeight="26.0" prefWidth="354.0" style="-fx-border-color: black;" />
         </children>
      </HBox>
      <HBox maxWidth="-Infinity" prefHeight="26.0" prefWidth="500.0" spacing="20.0">
         <children>
            <ComboBox fx:id="comboPrazo" prefWidth="150.0" />
            <Label fx:id="lblTituloLivro1" alignment="CENTER" prefHeight="26.0" prefWidth="354.0" style="-fx-border-color: black;" text="Prazo de devolução (Dias)" />
         </children>
      </HBox>
      <Button mnemonicParsing="false" onAction="#handleFinalizarEmprestimo" text="Realizar empréstimo" translateY="20.0" />
      <HBox prefHeight="38.0" prefWidth="308.0" spacing="15.0" translateY="200.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAbrirTelaDevolucao" prefHeight="35.0" prefWidth="139.0" text="Realizar devolução" />
            <Button mnemonicParsing="false" onAction="#handleAbrirTelaExtensao" prefHeight="35.0" prefWidth="139.0" text="Estender prazo" />
         </children>
      </HBox>
   </children>
</VBox>
